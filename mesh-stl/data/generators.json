{
  "version": 1,
  "comment": "Семейства генераторов. По умолчанию (generators.root = \"package\") script и preset.dir берутся из этого пакета; generators.root = \"project\" переключает python-семейства на projectScript/projectPreset (исследовательское дерево geometry/). built-in engine \"primitive\"/\"js\" — без Python.",
  "families": [
    {
      "id": "fcc-cell",
      "title": "FCC-ячейка (сфера + шейки)",
      "description": "Параметрическая FCC-ячейка поровой среды: сферы в узлах + шейки; сырой STL от CAD/CSG чистится и проверяется автоматически.",
      "script": "@package/generators/pore_cell/gen_fcc_cell.py",
      "preset": {
        "dir": "@package/generators/presets/pore_cell",
        "default": "fcc_cell_d5_r049.json",
        "ext": ".json",
        "include": [
          "fcc_cell_*.json"
        ]
      },
      "steps": [
        {
          "description": "генерация сырого STL + чистка",
          "args": [
            "--params-file",
            "{paramsFile}",
            "--out",
            "{rawOut}",
            "--clean-out",
            "{cleanOut}",
            "--json",
            "{json}"
          ]
        }
      ],
      "outputs": [
        {
          "role": "solid",
          "path": "{cleanOut}",
          "qa": true
        },
        {
          "role": "raw",
          "path": "{rawOut}",
          "qa": false
        }
      ],
      "notes": "Чистый STL пишется в stl_qa --clean-out. Для мешинга используйте {cleanOut}: сырой STL может содержать вырожденные грани.",
      "hints": [
        "stl-contract",
        "gap-rule",
        "snappy-stl-unit"
      ],
      "projectScript": "geometry/pore_cell/gen_fcc_cell.py",
      "requires": [
        "trimesh",
        "numpy",
        "cadquery"
      ],
      "projectPreset": {
        "dir": "geometry/pore_cell/params"
      }
    },
    {
      "id": "channel-spheres",
      "title": "Канал с упаковкой сфер (fluid + solid + именованные патчи)",
      "description": "Двухобластная геометрия: канал с набивкой сфер, отдельные STL для fluid/solid и именованных границ (inlet, outlet, walls, interface).",
      "script": "@package/generators/pore_cell/gen_channel_spheres.py",
      "preset": {
        "dir": "@package/generators/presets/pore_cell",
        "default": "channel_spheres_default.json",
        "ext": ".json",
        "include": [
          "channel_spheres_*.json"
        ]
      },
      "steps": [
        {
          "description": "генерация fluid_patches/solid/fluid + патчи",
          "args": [
            "--params",
            "{paramsFile}",
            "--out-dir",
            "{outDir}",
            "--units",
            "mm",
            "--fluid-patches"
          ]
        }
      ],
      "outputs": [
        {
          "role": "patches",
          "path": "{outDir}/fluid_patches.stl",
          "qa": true
        },
        {
          "role": "solid",
          "path": "{outDir}/solid.stl",
          "qa": true
        },
        {
          "role": "fluid",
          "path": "{outDir}/fluid.stl",
          "qa": true
        }
      ],
      "notes": "fluid_patches.stl идёт в snappyHexMesh как поверхность с уже готовыми именами патчей (inlet/outlet/walls/interface); для cfMesh имена переносятся через renameBoundary в meshDict (см. эксперимент exp-017).",
      "hints": [
        "channel-named-patches",
        "snappy-two-region",
        "snappy-interface-level"
      ],
      "projectScript": "geometry/pore_cell/gen_channel_spheres.py",
      "requires": [
        "trimesh",
        "numpy"
      ],
      "projectPreset": {
        "dir": "geometry/pore_cell/params"
      }
    },
    {
      "id": "double-layer-burner",
      "title": "Двухслойная горелка (solid + fluid)",
      "description": "Две области: твёрдый каркас и проточная часть; на выходе 4 файла — сырые и чистые STL для каждой области.",
      "script": "@package/generators/pore_cell/gen_double_layer_burner.py",
      "preset": {
        "dir": "@package/generators/presets/pore_cell",
        "default": "double_layer_burner_d5_fine167.json",
        "ext": ".json",
        "include": [
          "double_layer_burner_*.json"
        ]
      },
      "steps": [
        {
          "description": "генерация solid/fluid + чистка",
          "args": [
            "--params-file",
            "{paramsFile}",
            "--solid-out",
            "{solidRawOut}",
            "--solid-clean-out",
            "{solidOut}",
            "--fluid-out",
            "{fluidRawOut}",
            "--fluid-clean-out",
            "{fluidOut}",
            "--json",
            "{json}"
          ]
        }
      ],
      "outputs": [
        {
          "role": "solid",
          "path": "{solidOut}",
          "qa": true
        },
        {
          "role": "fluid",
          "path": "{fluidOut}",
          "qa": true
        },
        {
          "role": "solid_raw",
          "path": "{solidRawOut}",
          "qa": false
        },
        {
          "role": "fluid_raw",
          "path": "{fluidRawOut}",
          "qa": false
        }
      ],
      "notes": "Сырые *_raw.stl не мешить: используйте *_solid.stl и *_fluid.stl.",
      "hints": [
        "stl-contract",
        "snappy-two-region",
        "snappy-symmetry-domain"
      ],
      "projectScript": "geometry/pore_cell/gen_double_layer_burner.py",
      "requires": [
        "trimesh",
        "numpy",
        "cadquery"
      ],
      "projectPreset": {
        "dir": "geometry/pore_cell/params"
      }
    },
    {
      "id": "packing",
      "title": "Упаковка сфер (таблица → STL)",
      "description": "Двухшаговый генератор: сначала таблица шаров/контактов, затем STL твёрдого каркаса и проточной части с шейками.",
      "script": "@package/generators/packings/gen_packing_stl.py",
      "preset": {
        "dir": "@package/generators/presets/packings",
        "default": "box_mono_d1.json",
        "ext": ".json",
        "include": [
          "*.json"
        ]
      },
      "steps": [
        {
          "description": "таблица шаров и контактов",
          "script": "geometry/packings/gen_packing_table.py",
          "args": [
            "--params-file",
            "{paramsFile}",
            "--out",
            "{ballsCsv}",
            "--contacts-out",
            "{contactsCsv}",
            "--json",
            "{packingJson}"
          ]
        },
        {
          "description": "STL solid + fluid (шейки)",
          "script": "geometry/packings/gen_packing_stl.py",
          "args": [
            "--params-file",
            "{paramsFile}",
            "--balls",
            "{ballsCsv}",
            "--contacts",
            "{contactsCsv}",
            "--solid-out",
            "{solidOut}",
            "--fluid-out",
            "{fluidOut}",
            "--json",
            "{json}"
          ]
        }
      ],
      "outputs": [
        {
          "role": "solid",
          "path": "{solidOut}",
          "qa": true
        },
        {
          "role": "fluid",
          "path": "{fluidOut}",
          "qa": true
        }
      ],
      "notes": "Число шаров задаётся в params (или --max-spheres в CLI таблицы); при больших упаковках генерация STL может идти минуты.",
      "hints": [
        "packing-pipeline",
        "gap-rule",
        "stl-contract"
      ],
      "projectScript": "geometry/packings/gen_packing_stl.py",
      "requires": [
        "trimesh",
        "numpy"
      ],
      "projectPreset": {
        "dir": "geometry/packings/params"
      }
    },
    {
      "id": "cad-porous",
      "title": "CAD-геометрия (CadQuery): блок/канал/плита со сферами",
      "description": "CAD-генератор для сложных составных форм; сырой STL OCC почти всегда не watertight — обязательна чистка.",
      "script": "@package/generators/cad/gen_cq_porous.py",
      "preset": {
        "dir": "@package/generators/presets/cad",
        "default": "block_spheres_10mm_L3.json",
        "ext": ".json",
        "include": [
          "*.json"
        ]
      },
      "steps": [
        {
          "description": "генерация CAD-геометрии в STL",
          "args": [
            "--params-file",
            "{paramsFile}",
            "--out",
            "{rawOut}",
            "--json",
            "{json}"
          ]
        }
      ],
      "outputs": [
        {
          "role": "raw",
          "path": "{rawOut}",
          "qa": true
        }
      ],
      "notes": "Тесселяцию задаёт angularTolerance в params (0.1 — точный объём, 0.2–0.3 — для мешинга); после генерации чистите: stl_check({ stl, cleanup: true }).",
      "hints": [
        "cadquery-tessellation",
        "stl-cleanup",
        "gmsh-tetra-unfit"
      ],
      "projectScript": "geometry/cad/gen_cq_porous.py",
      "requires": [
        "trimesh",
        "numpy",
        "cadquery"
      ],
      "projectPreset": {
        "dir": "geometry/cad/params"
      }
    },
    {
      "id": "primitive",
      "title": "Портируемые примитивы (куб, сфера, цилиндр)",
      "description": "STL из встроенного генератора в JS: без Python, без CAD, без данных проекта. Нужен, чтобы проверить маршрут мешинга на чужой машине и в бенчмарке.",
      "engine": "primitive",
      "script": "mesh-stl/lib/primitives.js",
      "preset": {
        "dir": "@package/data/primitives",
        "default": "cube_10mm.json",
        "ext": ".json",
        "include": [
          "*.json"
        ]
      },
      "steps": [],
      "outputs": [
        {
          "role": "solid",
          "path": "{cleanOut}",
          "qa": true
        }
      ],
      "notes": "Единицы — мм, одна замкнутая оболочка, нормали наружу. Параметры: shape (box|sphere|cylinder), size_mm / radius_mm+height_mm, center_mm, segments/rings/sections. Вне проекта STL пишется, QA недоступен без tools/qa/stl_qa.py.",
      "hints": [
        "stl-contract",
        "units-mm"
      ]
    },
    {
      "id": "stratified-channel",
      "title": "Стратифицированный канал (две жидкости, горизонтальный интерфейс)",
      "description": "Прямоугольный канал, разрезанный плоскостью z = interface_z: lower.stl (низ) и upper.stl (верх), по 12 треугольников, единицы мм. Встроенный генератор на JS: без Python, без CAD, без данных проекта.",
      "script": "lib/generators/stratified.js",
      "preset": {
        "dir": "@package/generators/presets/stratified",
        "default": "channel_10x10x20_h8.json",
        "ext": ".json",
        "include": [
          "*.json"
        ]
      },
      "steps": [],
      "outputs": [
        {
          "role": "fluid",
          "path": "{outDir}/{name}.lower.stl",
          "qa": true
        },
        {
          "role": "fluid",
          "path": "{outDir}/{name}.upper.stl",
          "qa": true
        }
      ],
      "notes": "Плоскость горизонтальная, без наклона; пористой начинки нет — это чистый стратифицированный слой. Для двухфазной/CHT-задачи интерфейс лучше сшивать conform-мешером (gmsh route D).",
      "hints": [
        "stl-contract",
        "units-mm",
        "gap-rule"
      ],
      "engine": "js",
      "runner": "lib/generators/stratified.js"
    },
    {
      "id": "blob-foam",
      "title": "Блочная пена (метаболы → изоповерхность)",
      "description": "Пористая пена из перекрывающихся «блобов»: поле метаболов на сетке, изопорог (или подбор под целевую пористость бисекцией), обрезка аналитическим доменом через SDF, marching cubes. Повторяет Blender-подход «метаболы + voxel remesh + Boolean Intersect» без Blender и без CAD; в отчёте — пористость, связность твёрдого/порового пространства и распределения толщин.",
      "script": "@package/generators/pore_cell/gen_blob_foam.py",
      "preset": {
        "dir": "@package/generators/presets/pore_cell",
        "default": "blob_foam_d10x10_phi80.json",
        "ext": ".json",
        "include": [
          "blob_foam_*.json"
        ]
      },
      "steps": [
        {
          "description": "поле → изоповерхность → STL + чистка + QA",
          "args": [
            "--params-file",
            "{paramsFile}",
            "--out",
            "{rawOut}",
            "--clean-out",
            "{cleanOut}",
            "--json",
            "{json}",
            "--check"
          ]
        }
      ],
      "outputs": [
        {
          "role": "solid",
          "path": "{cleanOut}",
          "qa": true
        },
        {
          "role": "raw",
          "path": "{rawOut}",
          "qa": false
        }
      ],
      "notes": "Мешить {cleanOut}. Пористость задаётся target_porosity (бисекция по изопорогу) либо фиксированным threshold. voxel_mm — разрешение поля: шаг ≤ 0.1·r_min, иначе теряются шейки. Домен — цилиндр вдоль z или куб.",
      "hints": [
        "stl-contract",
        "gap-rule",
        "snappy-stl-unit"
      ],
      "projectScript": "geometry/pore_cell/gen_blob_foam.py",
      "requires": [
        "trimesh",
        "numpy",
        "scipy",
        "skimage"
      ],
      "projectPreset": {
        "dir": "geometry/pore_cell/params"
      }
    },
    {
      "id": "box-array",
      "title": "Решётка сфер/цилиндров (box-array)",
      "description": "Регулярная решётка nx×ny×nz сфер или цилиндров в коробке: solid.stl (N замкнутых оболочек) и container.stl (сама коробка). Встроенный генератор на JS, единицы мм — годится для проверки мешинга вне проекта.",
      "engine": "js",
      "runner": "lib/generators/box-array.js",
      "script": "lib/generators/box-array.js",
      "preset": {
        "dir": "@package/generators/presets/box-array",
        "default": "array_spheres.json",
        "ext": ".json",
        "include": [
          "*.json"
        ]
      },
      "steps": [],
      "outputs": [
        {
          "role": "solid",
          "path": "{outDir}/{name}.solid.stl",
          "qa": true
        },
        {
          "role": "container",
          "path": "{outDir}/{name}.container.stl",
          "qa": false
        }
      ],
      "notes": "Параметры: container_mm, lattice [nx,ny,nz], shape (sphere|cylinder), radius_mm, height_mm (цилиндр), margin_mm, segments/rings/sections. Если шаг решётки меньше размера тела, в JSON пишется предупреждение: snappy прочитает пересекающиеся оболочки как одно тело.",
      "hints": [
        "stl-contract",
        "units-mm"
      ]
    }
  ]
}
