{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "case-manifest.schema.json",
  "title": "case-manifest.json",
  "description": "Which solver and boundary layout a scaffold created, so downstream tools read it instead of guessing from dictionaries.",
  "type": "object",
  "required": ["schemaVersion", "createdAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "solver": { "type": ["string", "null"] },
    "algorithm": { "type": ["string", "null"] },
    "compressible": { "type": "boolean" },
    "phases": { "type": ["integer", "string", "null"] },
    "turbulence": { "type": ["string", "null"] },
    "units": { "enum": ["mm", "m"] },
    "dimension": { "type": "integer" },
    "patches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "role": { "type": "string" }
        },
        "required": ["name", "type"]
      }
    },
    "createdBy": { "type": ["string", "null"] },
    "createdAt": { "type": "string" }
  }
}
