{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "stl-passport.schema.json",
  "title": "stl-passport (registry row)",
  "description": "One row of stl/registry.csv: the geometry passport used before meshing.",
  "type": "object",
  "required": ["geom_id", "name", "generator", "units", "path"],
  "properties": {
    "geom_id": { "type": "string" },
    "name": { "type": "string" },
    "family": { "type": "string" },
    "generator": { "type": "string" },
    "params_file": { "type": "string" },
    "seed": { "type": ["integer", "null"] },
    "units": { "enum": ["mm", "m"] },
    "domain_mm": { "type": "string" },
    "periodic": { "type": ["string", "boolean"] },
    "fluid_or_solid": { "type": "string" },
    "triangles": { "type": "integer" },
    "area_mm2": { "type": "number" },
    "volume_mm3": { "type": "number" },
    "bbox_mm": { "type": "string" },
    "watertight": { "type": "boolean" },
    "date": { "type": "string" },
    "path": { "type": "string" },
    "notes": { "type": "string" }
  }
}
