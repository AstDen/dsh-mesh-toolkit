{
  "version": 1,
  "comment": "Route = ordered shell steps run with the OpenFOAM environment sourced. Placeholders: {caseDir} {np} {msh} {python}. Conditions: always | blockMesh | features | parallel | serial | splitRegions. Edit this file to add/remove/improve a route; edit data/hints/*.json to add knowledge.",
  "profiles": {
    "gate": {
      "source": "OpenFOAM etc/caseDicts/annotated/meshQualityDict",
      "maxNonOrtho": 65,
      "maxBoundarySkewness": 20,
      "maxInternalSkewness": 4,
      "minFaceWeight": 0.05,
      "minVolRatio": 0.01,
      "minDeterminant": 0.001,
      "negativeVolume": 0
    },
    "project": {
      "maxNonOrtho": 60,
      "maxBoundarySkewness": 4,
      "maxInternalSkewness": 2,
      "minFaceWeight": 0.1,
      "minVolRatio": 0.05,
      "minDeterminant": 0.001,
      "negativeVolume": 0,
      "minLayerCoverage": 0.8
    }
  },
  "routes": [
    {
      "id": "snappy",
      "title": "snappyHexMesh (hex-dominant, layers, multi-region CHT)",
      "when": "primary path for pore STLs and two-region CHT cases; mesh with near-wall layers",
      "software": "OpenFOAM v2512",
      "evidence": [
        "exp-003",
        "exp-005",
        "exp-018"
      ],
      "requires": [
        "blockMesh",
        "snappyHexMesh"
      ],
      "steps": [
        {
          "name": "blockMesh",
          "run": "blockMesh -case {caseDir}",
          "when": "blockMesh",
          "timeoutMs": 900000
        },
        {
          "name": "surfaceFeatureExtract",
          "when": "featuresLegacy",
          "run": "surfaceFeatureExtract -case {caseDir}"
        },
        {
          "name": "surfaceFeatures",
          "when": "featuresNew",
          "run": "surfaceFeatures -case {caseDir}"
        },
        {
          "name": "decomposePar",
          "run": "decomposePar -force -case {caseDir}",
          "when": "parallel",
          "timeoutMs": 900000
        },
        {
          "name": "snappyHexMesh-parallel",
          "run": "mpirun --allow-run-as-root -np {np} snappyHexMesh -parallel -overwrite -case {caseDir}",
          "when": "parallel",
          "timeoutMs": 14400000
        },
        {
          "name": "snappyHexMesh",
          "run": "snappyHexMesh -overwrite -case {caseDir}",
          "when": "serial",
          "timeoutMs": 14400000
        },
        {
          "name": "reconstructParMesh",
          "run": "reconstructParMesh -constant {mergeTol} -case {caseDir}",
          "when": "parallel",
          "timeoutMs": 1800000
        },
        {
          "name": "splitMeshRegions",
          "run": "splitMeshRegions -cellZones -overwrite -case {caseDir}",
          "when": "splitRegions",
          "timeoutMs": 1800000
        }
      ],
      "failures": [
        "`Point (...) is not inside the mesh or on a face or edge` — locationInMesh is not in metres or the STL lacks scale 0.001",
        "0 layers extruded with the template minVol — the absolute minVol is too large (hint snappy-minvol)",
        "`Entry 'solver' not found` for castellatedBufferLayer — the _meshMotionSolver block is missing (hint snappy-buffer-layer-solver)",
        "one-sided interface after splitMeshRegions — geometry spots on the domain planes (hint snappy-domain-plane-spots)"
      ]
    },
    {
      "id": "cfmesh",
      "title": "cfMesh cartesianMesh (robust hex mesh)",
      "when": "complex geometry where snap is unstable; a hex mesh without layers is needed",
      "software": "cfMesh 1.2.0, OpenFOAM v2512",
      "evidence": [
        "exp-007",
        "exp-008",
        "exp-017"
      ],
      "requires": [
        "cartesianMesh"
      ],
      "steps": [
        {
          "name": "clean",
          "run": "rm -rf {caseDir}/constant/polyMesh {caseDir}/processor*",
          "when": "always",
          "timeoutMs": 60000
        },
        {
          "name": "decomposePar",
          "run": "decomposePar -force -case {caseDir}",
          "when": "parallel",
          "timeoutMs": 900000
        },
        {
          "name": "cartesianMesh-parallel",
          "run": "mpirun --allow-run-as-root -np {np} cartesianMesh -parallel -case {caseDir}",
          "when": "parallel",
          "timeoutMs": 14400000
        },
        {
          "name": "cartesianMesh",
          "run": "cartesianMesh -case {caseDir}",
          "when": "serial",
          "timeoutMs": 14400000
        },
        {
          "name": "reconstructParMesh",
          "run": "reconstructParMesh -constant -mergeTol 1e-6 -case {caseDir}",
          "when": "parallel",
          "timeoutMs": 1800000
        },
        {
          "name": "clean-processors",
          "run": "rm -rf {caseDir}/processor*",
          "when": "parallel",
          "timeoutMs": 60000
        }
      ],
      "failures": [
        "cfMesh comes from the OpenFOAM installation (platforms/*/bin after source etc/bashrc), not from a separate env/cfmesh-* build",
        "layers on top of tetra break conformity (D-018) — cartesianMesh is for hex meshes only",
        "pMesh does not run in parallel (argList::noParallel())"
      ]
    },
    {
      "id": "gmsh",
      "title": "gmsh OCC → conformal CHT (route D)",
      "when": "a conformal interface between two regions from STEP/OCC is needed instead of snappy",
      "software": "gmsh 4.15.2 (Python API) + gmshToFoam",
      "evidence": [
        "exp-014",
        "exp-016"
      ],
      "requires": [
        "gmshToFoam"
      ],
      "steps": [
        {
          "name": "build-msh",
          "run": "{python} {gmshScript} {gmshArgs}",
          "when": "always",
          "timeoutMs": 3600000
        },
        {
          "name": "gmshToFoam",
          "run": "gmshToFoam {msh} -case {caseDir}",
          "when": "always",
          "timeoutMs": 1800000
        },
        {
          "name": "splitMeshRegions",
          "run": "splitMeshRegions -cellZones -overwrite -case {caseDir}",
          "when": "splitRegions",
          "timeoutMs": 1800000
        }
      ],
      "failures": [
        "polyhedra written by foamMeshToFluent are not read by fluentMeshToFoam (unrecognised 3-D cell shape: 7) — use fluent3DMeshToFoam only",
        "changeDictionary does not work in region mode: set the patch type by editing constant/<region>/polyMesh/boundary",
        "ParaView 6.2.1 has no GmshReader: view via gmshToFoam → polyMesh"
      ]
    },
    {
      "id": "check",
      "title": "Check an existing case only",
      "when": "the mesh already exists; checkMesh + a quality gate per region are needed",
      "software": "OpenFOAM v2512",
      "evidence": [
        "AGENTS.md §6"
      ],
      "requires": [
        "constant/polyMesh or constant/<region>/polyMesh"
      ],
      "steps": []
    },
    {
      "id": "ops",
      "title": "Mesh surgery (whitelist steps): topoSet, subsetMesh, createPatch, createBaffles, stitchMesh, refineMesh, renumberMesh, collapseEdges, setSet, surfaceMeshExtract, mergeOrSplitBaffles, combinePatchFaces",
      "when": "a tutorial case or a hand-written pipeline needs mesh operations after blockMesh and before checkMesh",
      "software": "OpenFOAM.com 2606 (setSet/surfaceMeshExtract/refineHexMesh are com-only)",
      "evidence": [
        "exp-025"
      ],
      "requires": [
        "topoSet"
      ],
      "steps": [
        {
          "name": "setSet",
          "run": "setSet -batch system/setSetBatch -case {caseDir}",
          "when": "dict:system/setSetBatch"
        },
        {
          "name": "topoSet",
          "run": "topoSet -case {caseDir}",
          "when": "dict:system/topoSetDict"
        },
        {
          "name": "topoSet-dict",
          "run": "topoSet -dict {topoSetDict} -case {caseDir}",
          "when": "args:topoSetDict"
        },
        {
          "name": "subsetMesh",
          "run": "subsetMesh {subsetCellSet} -overwrite -case {caseDir}",
          "when": "args:subsetCellSet"
        },
        {
          "name": "createBaffles",
          "run": "createBaffles -overwrite -case {caseDir}",
          "when": "dict:system/createBafflesDict"
        },
        {
          "name": "createPatch",
          "run": "createPatch -overwrite -case {caseDir}",
          "when": "dict:system/createPatchDict"
        },
        {
          "name": "stitchMesh",
          "run": "stitchMesh {stitchPatches} -overwrite -case {caseDir}",
          "when": "args:stitchPatches"
        },
        {
          "name": "refineMesh",
          "run": "refineMesh -overwrite -case {caseDir}",
          "when": "dict:system/refineMeshDict"
        },
        {
          "name": "refineHexMesh",
          "run": "refineHexMesh -overwrite -case {caseDir}",
          "when": "dict:system/refineHexMeshDict"
        },
        {
          "name": "collapseEdges",
          "run": "collapseEdges -overwrite -case {caseDir}",
          "when": "dict:system/collapseDict"
        },
        {
          "name": "mergeOrSplitBaffles",
          "run": "mergeOrSplitBaffles -overwrite -case {caseDir}",
          "when": "dict:system/mergeOrSplitBafflesDict"
        },
        {
          "name": "combinePatchFaces",
          "run": "combinePatchFaces {combinePatches} -overwrite -case {caseDir}",
          "when": "args:combinePatches"
        },
        {
          "name": "surfaceMeshExtract",
          "run": "surfaceMeshExtract -case {caseDir}",
          "when": "dict:system/surfaceMeshExtractDict"
        },
        {
          "name": "renumberMesh",
          "run": "renumberMesh -overwrite -case {caseDir}",
          "when": "args:renumber"
        },
        {
          "name": "checkMesh",
          "run": "checkMesh -case {caseDir}",
          "when": "always"
        }
      ],
      "failures": [
        "step silently skipped: its dictionary is missing — the `when: \"dict:...\"` conditions are the only gate",
        "setSet/surfaceMeshExtract/refineHexMesh are OpenCFD-only: on org14 the preflight refuses route ops"
      ]
    },
    {
      "id": "blockmesh",
      "title": "blockMesh from an explicit spec (no STL): vertices, blocks, edges, boundary, mergePatchPairs",
      "when": "structured hex blocks, tutorials, a background mesh before snappy, or an extruded/polyDual start surface",
      "software": "any OpenFOAM (blockMesh is core)",
      "evidence": [
        "exp-025"
      ],
      "requires": [
        "blockMesh"
      ],
      "steps": [
        {
          "name": "blockMesh",
          "run": "blockMesh -case {caseDir}",
          "when": "always",
          "timeoutMs": 900000
        },
        {
          "name": "checkMesh",
          "run": "checkMesh -case {caseDir}",
          "when": "always"
        }
      ],
      "failures": [
        "blockMeshDict from a spec must keep `geometry{}` when vertices/faces are projected (`project (x y z) ( surface )`)",
        "a spec cannot express named vertices (name v0 project ...), projectCurve edges or transform{} — use the tutorial runner for those cases (blockMesh/pipe)"
      ]
    }
  ]
}
